# Local development. Use HTTPS origins and long random secrets in production.
DATABASE_URL=mysql://launch:change-me@127.0.0.1:3307/launch
APP_ORIGIN=http://launch.localhost:3000
# Wildcard DNS: <design-id>.sites.example.com and <design-id>-r1.sites.example.com
SITE_BASE_DOMAIN=launch.localhost:3000
SITE_PROTOCOL=http
STORAGE_ROOT=./storage
SESSION_SECRET=replace-with-at-least-32-random-characters
MYSQL_DATABASE=launch
MYSQL_USER=launch
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

DB_PORT=3307

# Caddy certificate permission token (32+ characters).
TLS_ASK_SECRET=replace-with-another-32-character-random-secret
APP_HOST=launch.localhost
ACME_EMAIL=
